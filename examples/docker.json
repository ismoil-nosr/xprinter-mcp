{
  "mcpServers": {
    "xprinter": {
      "command": "/absolute/path/to/docker",
      "args": [
        "run", "--rm", "-i", "--init", "--read-only",
        "--cap-drop=ALL", "--security-opt=no-new-privileges", "--pids-limit=64", "--memory=512m",
        "--mount", "type=volume,source=xprinter-mcp-state,target=/var/lib/xprinter",
        "--mount", "type=bind,source=/absolute/path/to/secrets/id_ed25519,target=/run/secrets/id_ed25519,readonly",
        "--mount", "type=bind,source=/absolute/path/to/secrets/known_hosts,target=/run/secrets/known_hosts,readonly",
        "-e", "XPRINTER_SSH_HOST=host.docker.internal",
        "-e", "XPRINTER_SSH_USER=MAC_USERNAME",
        "-e", "XPRINTER_ALLOW_PRINT=0",
        "-e", "XPRINTER_LANGUAGE=en",
        "ghcr.io/ismoil-nosr/xprinter-mcp:0.2.1", "stdio"
      ]
    }
  }
}
