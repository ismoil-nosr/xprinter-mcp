# Copy to docker.env. This file contains configuration/paths only, never a private key or access token.
XPRINTER_IMAGE=ghcr.io/ismoil-nosr/xprinter-mcp:0.2.1
# Docker Desktop on the printer Mac: host.docker.internal; elsewhere: the printer Mac's reachable IP/DNS name.
XPRINTER_SSH_HOST=host.docker.internal
XPRINTER_SSH_PORT=22
XPRINTER_SSH_USER=MAC_USERNAME
XPRINTER_KEY_FILE=./secrets/id_ed25519
XPRINTER_KNOWN_HOSTS_FILE=./secrets/known_hosts
XPRINTER_STATE_VOLUME=xprinter-mcp-state
# Enable only after checking stock and a preview; preserve the volume across all container recreations.
XPRINTER_ALLOW_PRINT=0
XPRINTER_LANGUAGE=en
XPRINTER_MAX_LABELS_PER_JOB=100
XPRINTER_MAX_LABELS_PER_HOUR=500
# Optional HTTP profile. Needs an actual HTTPS reverse proxy and an audience-bound JWT OAuth provider.
XPRINTER_HTTP_PORT=8787
XPRINTER_PUBLIC_URL=
XPRINTER_OAUTH_ISSUER=
XPRINTER_OAUTH_JWKS_URL=
XPRINTER_ALLOWED_ORIGINS=
